# Copy to .env at the repo root and fill in. The server dev script loads it if present.

# Required. Secret used to sign sessions — use a long random string.
BETTER_AUTH_SECRET=

# Optional. Public URL of the server (defaults to http://localhost:3000).
BETTER_AUTH_URL=http://localhost:3000

# Optional. Postgres connection (defaults to the docker-compose sidecar).
DATABASE_URL=postgres://thecrew:thecrew@localhost:5432/thecrew

# Optional. Comma-separated extra origins allowed to open the WebSocket.
# Same-origin http(s) origins are always allowed; non-browser origins
# (file://, custom protocols) are allowed per ADR-0007.
WS_ALLOWED_ORIGINS=
