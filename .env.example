# Copy to .env at the repo root and fill in. The server dev script loads it if present.

# Required. Secret used to sign sessions — use a long random string.
BETTER_AUTH_SECRET=

# Optional. Public URL of the server (defaults to http://localhost:3000).
BETTER_AUTH_URL=http://localhost:3000

# Postgres sidecar credentials (used by docker-compose.yml for variable
# substitution). POSTGRES_USER and POSTGRES_DB default to thecrew.
POSTGRES_USER=thecrew
# Required. No default — pick a random password.
POSTGRES_PASSWORD=
POSTGRES_DB=thecrew

# Required. Postgres connection string (docker-compose sidecar).
# Must use the same credentials as the POSTGRES_* vars above.
DATABASE_URL=postgres://thecrew:<POSTGRES_PASSWORD>@localhost:5432/thecrew

# Optional. Comma-separated extra origins allowed to open the WebSocket.
# Same-origin http(s) origins are always allowed; non-browser origins
# (file://, custom protocols) are allowed per ADR-0007.
WS_ALLOWED_ORIGINS=
